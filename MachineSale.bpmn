    <bpmn:laneSet id="LaneSet_01m9shl">
      <bpmn:lane id="Lane_0gdmh2n" name="Employee">
        <bpmn:flowNodeRef>Gateway_CustomerDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>StartEvent_RequestMachineSale</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_IdentifyRequirements</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TechnicalConsultancy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PresentMachines</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ProvideAdicionalInformation</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_1b92s11" name="Client">
        <bpmn:flowNodeRef>EndEvent_MachineSaleDone</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReceiveContract</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_1slb4y4" name="Storage">
        <bpmn:flowNodeRef>Activity_SearchDB</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_ReserveMachine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_DBVerification</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_0h6tbai</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_SaveSale</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_OrderMachine</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:exclusiveGateway id="Gateway_CustomerDecision" name="Customer Decision?">
      <bpmn:incoming>Flow_05l7scf</bpmn:incoming>
      <bpmn:outgoing>Flow_MachineRejected</bpmn:outgoing>
      <bpmn:outgoing>Flow_MachineAccepted</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:startEvent id="StartEvent_RequestMachineSale" name="Request Machine Sale">
      <bpmn:outgoing>Flow_044lgtg</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_IdentifyRequirements" name="Identify Requirements">
      <bpmn:extensionElements>
        <zeebe:formDefinition formKey="camunda-forms:bpmn:UserTaskForm_3q0vpne" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_044lgtg</bpmn:incoming>
      <bpmn:outgoing>Flow_01vxss3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_TechnicalConsultancy" name="Technical Consultancy">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="techinicalCunsultancy" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_01vxss3</bpmn:incoming>
      <bpmn:incoming>Flow_07mi8cd</bpmn:incoming>
      <bpmn:outgoing>Flow_1xyli22</bpmn:outgoing>
      <bpmn:property id="Property_0v9pyei" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DataInputAssociation_0szye2u">
        <bpmn:sourceRef>DataStoreReference_MachinesDB</bpmn:sourceRef>
        <bpmn:targetRef>Property_0v9pyei</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_PresentMachines" name="Present Machines">
      <bpmn:extensionElements>
        <zeebe:formDefinition formKey="camunda-forms:bpmn:UserTaskForm_0f5onln" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1xyli22</bpmn:incoming>
      <bpmn:outgoing>Flow_05l7scf</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_ProvideAdicionalInformation" name="Provide Adicional Information">
      <bpmn:extensionElements>
        <zeebe:formDefinition formKey="camunda-forms:bpmn:UserTaskForm_3uv1mm1" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_MachineRejected</bpmn:incoming>
      <bpmn:outgoing>Flow_07mi8cd</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:dataStoreReference id="DataStoreReference_MachinesDB" name="MachinesDB" />
    <bpmn:serviceTask id="Activity_SearchDB" name="Search DB">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="searchDB" />
        <zeebe:ioMapping>
          <zeebe:input source="=machineID" target="machineID" />
          <zeebe:output source="=machineID" target="machineID" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_MachineAccepted</bpmn:incoming>
      <bpmn:outgoing>Flow_0gtd8gh</bpmn:outgoing>
      <bpmn:property id="Property_0dpzypu" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DataInputAssociation_Storage">
        <bpmn:sourceRef>DataStoreReference_StorageDB</bpmn:sourceRef>
        <bpmn:targetRef>Property_0dpzypu</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="DataStoreReference_StorageDB" name="StorageDB" />
    <bpmn:serviceTask id="Activity_ReserveMachine" name="Reserve Machine">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="reserveMachine" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_MachineExist</bpmn:incoming>
      <bpmn:outgoing>Flow_0ful3lf</bpmn:outgoing>
      <bpmn:property id="Property_0nnfwqb" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DataInputAssociation_1r9d9vy">
        <bpmn:sourceRef>DataStoreReference_StorageDB</bpmn:sourceRef>
        <bpmn:targetRef>Property_0nnfwqb</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_DBVerification" name="DB Verification" default="Flow_MachineDontExist">
      <bpmn:incoming>Flow_0gtd8gh</bpmn:incoming>
      <bpmn:outgoing>Flow_MachineDontExist</bpmn:outgoing>
      <bpmn:outgoing>Flow_MachineExist</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_0h6tbai">
      <bpmn:incoming>Flow_0vqqlwj</bpmn:incoming>
      <bpmn:incoming>Flow_0ful3lf</bpmn:incoming>
      <bpmn:outgoing>Flow_0w41f4c</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndEvent_MachineSaleDone" name="Machine Sale Done">
      <bpmn:incoming>Flow_18ks2xu</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:manualTask id="Task_ReceiveContract" name="Receive Contract">
      <bpmn:incoming>Flow_034lqn6</bpmn:incoming>
      <bpmn:outgoing>Flow_18ks2xu</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:serviceTask id="Activity_SaveSale" name="Save Sale">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="saveSale" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0w41f4c</bpmn:incoming>
      <bpmn:outgoing>Flow_034lqn6</bpmn:outgoing>
      <bpmn:property id="Property_0lgrdyb" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DataInputAssociation_13jsy23">
        <bpmn:sourceRef>DataStoreReference_SalesBD</bpmn:sourceRef>
        <bpmn:targetRef>Property_0lgrdyb</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="DataStoreReference_SalesBD" name="SalesBD" />
    <bpmn:sendTask id="Activity_OrderMachine" name="Order Machine">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="orderMachine" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_MachineDontExist</bpmn:incoming>
      <bpmn:outgoing>Flow_0vqqlwj</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sequenceFlow id="Flow_05l7scf" sourceRef="Task_PresentMachines" targetRef="Gateway_CustomerDecision" />
    <bpmn:sequenceFlow id="Flow_MachineAccepted" name="Machine Accepted" sourceRef="Gateway_CustomerDecision" targetRef="Activity_SearchDB">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=Decision = "accept"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_MachineRejected" name="Machine Rejected" sourceRef="Gateway_CustomerDecision" targetRef="Task_ProvideAdicionalInformation">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=Decision = "reject"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_044lgtg" sourceRef="StartEvent_RequestMachineSale" targetRef="Task_IdentifyRequirements" />
    <bpmn:sequenceFlow id="Flow_01vxss3" sourceRef="Task_IdentifyRequirements" targetRef="Task_TechnicalConsultancy" />
    <bpmn:sequenceFlow id="Flow_07mi8cd" sourceRef="Task_ProvideAdicionalInformation" targetRef="Task_TechnicalConsultancy" />
    <bpmn:sequenceFlow id="Flow_1xyli22" sourceRef="Task_TechnicalConsultancy" targetRef="Task_PresentMachines" />
    <bpmn:sequenceFlow id="Flow_0gtd8gh" sourceRef="Activity_SearchDB" targetRef="Gateway_DBVerification" />
    <bpmn:sequenceFlow id="Flow_MachineExist" name="Machine Exist" sourceRef="Gateway_DBVerification" targetRef="Activity_ReserveMachine">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=MachineExists = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_0ful3lf" sourceRef="Activity_ReserveMachine" targetRef="Gateway_0h6tbai" />
    <bpmn:sequenceFlow id="Flow_MachineDontExist" name="Machine Dont Exist" sourceRef="Gateway_DBVerification" targetRef="Activity_OrderMachine" />
    <bpmn:sequenceFlow id="Flow_0vqqlwj" sourceRef="Activity_OrderMachine" targetRef="Gateway_0h6tbai" />
    <bpmn:sequenceFlow id="Flow_0w41f4c" sourceRef="Gateway_0h6tbai" targetRef="Activity_SaveSale" />
    <bpmn:sequenceFlow id="Flow_18ks2xu" sourceRef="Task_ReceiveContract" targetRef="EndEvent_MachineSaleDone" />
    <bpmn:sequenceFlow id="Flow_034lqn6" sourceRef="Activity_SaveSale" targetRef="Task_ReceiveContract" />
  </bpmn:process>
  <bpmn:message id="Message_0pgjhlq" name="Message_ReceiveNotification">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=ReceiveNotification" />
