    <bpmn:laneSet id="LaneSet_1gwf4nk">
      <bpmn:lane id="Lane_1unqa32" name="Mecânico">
        <bpmn:flowNodeRef>Event_0vl6rzg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Repair</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_IdentifyProblem</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_CheckAnswer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_1iy8r43</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_ArchiveRepair</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_ReparacaoConcluida</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_CancelRepair</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_StartRepair</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_EndRepair</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_0hmop69</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_Notification</bpmn:flowNodeRef>
        <bpmn:childLaneSet id="LaneSet_15fe5y7" />
      </bpmn:lane>
      <bpmn:lane id="Lane_0jxqm51" name="Cliente">
        <bpmn:flowNodeRef>StartEvent_PedidoReparacao</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_SignRepair</bpmn:flowNodeRef>
        <bpmn:childLaneSet id="LaneSet_1ud6gyl" />
      </bpmn:lane>
      <bpmn:lane id="Lane_1flffqw" name="Escritório">
        <bpmn:flowNodeRef>Activity_ScheduleRepair</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_ReceiveOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_ReceiveReport</bpmn:flowNodeRef>
        <bpmn:childLaneSet id="LaneSet_12wt9gi" />
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:userTask id="Activity_ScheduleRepair" name="Agendar visita técnica">
      <bpmn:extensionElements>
        <zeebe:formDefinition formKey="camunda-forms:bpmn:UserTaskForm_1r47jh0" />
        <zeebe:properties>
          <zeebe:property name="camundaModeler:exampleOutputJson" value="{&#34;orderId&#34;:&#34;1&#34;,&#34;clientName&#34;:&#34;John&#34;,&#34;contactNumber&#34;:&#34;911111111&#34;,&#34;machineBrand&#34;:&#34;Brand1&#34;,&#34;machineModel&#34;:&#34;Model1&#34;,&#34;issueDescription&#34;:&#34;Não liga&#34;,&#34;repairDate&#34;:&#34;2024-12-02&#34;}" />
        </zeebe:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_05emuyj</bpmn:incoming>
      <bpmn:outgoing>Flow_1eyex0m</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:startEvent id="StartEvent_PedidoReparacao" name="Pedido de reparação">
      <bpmn:outgoing>Flow_0dth63b</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="Event_0vl6rzg" name="Reparação rejeitada">
      <bpmn:incoming>Flow_17c1wke</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Gateway_Repair" name="Reparação?">
      <bpmn:extensionElements />
      <bpmn:incoming>Flow_13i6ibn</bpmn:incoming>
      <bpmn:outgoing>Flow_RejectRepair</bpmn:outgoing>
      <bpmn:outgoing>Flow_AcceptRepair</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="Activity_IdentifyProblem" name="Identificar problema da máquina">
      <bpmn:incoming>Flow_1et1zbt</bpmn:incoming>
      <bpmn:outgoing>Flow_1xiahk9</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:userTask id="Activity_CheckAnswer" name="Avaliar resposta de Cliente">
      <bpmn:extensionElements>
        <zeebe:formDefinition formKey="camunda-forms:bpmn:UserTaskForm_2b9k9l5" />
        <zeebe:properties>
          <zeebe:property name="camundaModeler:exampleOutputJson" value="{&#34;orderId&#34;:&#34;1&#34;,&#34;clientName&#34;:&#34;John&#34;,&#34;contactNumber&#34;:&#34;911111111&#34;,&#34;machineBrand&#34;:&#34;Brand1&#34;,&#34;machineModel&#34;:&#34;Model1&#34;,&#34;issueDescription&#34;:&#34;Não liga&#34;,&#34;decision&#34;:&#34;accepted&#34;}" />
        </zeebe:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1xiahk9</bpmn:incoming>
      <bpmn:outgoing>Flow_13i6ibn</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="Gateway_1iy8r43">
      <bpmn:incoming>Flow_1afzky9</bpmn:incoming>
      <bpmn:incoming>Flow_0c148l4</bpmn:incoming>
      <bpmn:outgoing>Flow_180mb34</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:manualTask id="Activity_SignRepair" name="Assinar Relatório">
      <bpmn:incoming>Flow_1mc40zd</bpmn:incoming>
      <bpmn:outgoing>Flow_0c148l4</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:serviceTask id="Activity_ArchiveRepair" name="Arquivar Reparação">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="saveRepair" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_180mb34</bpmn:incoming>
      <bpmn:outgoing>Flow_1wbjo66</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_ReparacaoConcluida" name="Reparação Concluída">
      <bpmn:incoming>Flow_1wbjo66</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Activity_ReceiveOrder" name="Receber a ordem de serviço">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="marcarReparacao" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0dth63b</bpmn:incoming>
      <bpmn:outgoing>Flow_05emuyj</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Activity_CancelRepair" name="Cancelar Reparação">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="cancelaReparacao" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_RejectRepair</bpmn:incoming>
      <bpmn:outgoing>Flow_17c1wke</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Activity_StartRepair" name="Iniciar Reparação">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="iniciarReparacao" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_AcceptRepair</bpmn:incoming>
      <bpmn:outgoing>Flow_0tgmhmm</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Activity_EndRepair" name="Concluir Reparação">
      <bpmn:extensionElements>
        <zeebe:formDefinition formKey="camunda-forms:bpmn:UserTaskForm_18fllcr" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0tgmhmm</bpmn:incoming>
      <bpmn:outgoing>Flow_0suw28y</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="Gateway_0hmop69">
      <bpmn:incoming>Flow_0suw28y</bpmn:incoming>
      <bpmn:outgoing>Flow_1mc40zd</bpmn:outgoing>
      <bpmn:outgoing>Flow_011pts5</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="Activity_ReceiveReport" name="Receber Relatório">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="receiveReport" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_011pts5</bpmn:incoming>
      <bpmn:outgoing>Flow_1afzky9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Activity_Notification" name="Receber notificação">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="receiveNotification" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1eyex0m</bpmn:incoming>
      <bpmn:outgoing>Flow_1et1zbt</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_05emuyj" sourceRef="Activity_ReceiveOrder" targetRef="Activity_ScheduleRepair" />
    <bpmn:sequenceFlow id="Flow_1eyex0m" sourceRef="Activity_ScheduleRepair" targetRef="Activity_Notification" />
    <bpmn:sequenceFlow id="Flow_0dth63b" sourceRef="StartEvent_PedidoReparacao" targetRef="Activity_ReceiveOrder" />
    <bpmn:sequenceFlow id="Flow_17c1wke" sourceRef="Activity_CancelRepair" targetRef="Event_0vl6rzg" />
    <bpmn:sequenceFlow id="Flow_13i6ibn" sourceRef="Activity_CheckAnswer" targetRef="Gateway_Repair" />
    <bpmn:sequenceFlow id="Flow_AcceptRepair" name="Aceita" sourceRef="Gateway_Repair" targetRef="Activity_StartRepair">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=decision="accepted"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_RejectRepair" name="Rejeita" sourceRef="Gateway_Repair" targetRef="Activity_CancelRepair">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=decision="rejected"</bpmn:conditionExpression>
